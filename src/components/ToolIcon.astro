---

<span class="tool-icon" aria-hidden="true">
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.7"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    {paths[toolId].map((path) => <path d={path} />)}
  </svg>
</span>
