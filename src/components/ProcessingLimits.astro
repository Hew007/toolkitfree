---
import { IMAGE_BUDGET_LIMITS, MAX_SINGLE_IMAGE_PIXELS } from '../lib/image-budget';
import { MAX_SPLIT_TILES } from '../lib/image-splitter';

interface Props {
  /** `batch` covers the multi-file tools; `splitter` takes one image and emits many pieces. */
  profile?: 'batch' | 'splitter';
}

const { profile = 'batch' } = Astro.props;
const isSplitter = profile === 'splitter';
const desktop = IMAGE_BUDGET_LIMITS.desktop;
const mobile = IMAGE_BUDGET_LIMITS.mobile;
const asMegapixels = (value: number) => `${value / 1_000_000} MP`;
const asMemory = (value: number) =>
  value >= 1024 * 1024 * 1024
    ? `${value / (1024 * 1024 * 1024)} GiB`
    : `${value / (1024 * 1024)} MiB`;
---

<section class="spec-section" aria-labelledby="processing-limits">
  <div class="section-heading-row compact">
    <div>
      <p class="section-index">Practical limits</p>
      <h2 id="processing-limits">Browser processing safeguards</h2>
    </div>
    <p>
      These are ToolkitFree screening thresholds, not promises that every browser can reach them.
    </p>
  </div>
  <div class="table-scroll" tabindex="0" aria-label="Scrollable processing limits table">
    <table class="spec-table">
      <thead>
        <tr
          ><th scope="col">Safeguard</th><th scope="col">Desktop</th><th scope="col">Mobile</th></tr
        >
      </thead>
      <tbody>
        <tr>
          <th scope="row">Single-image hard cap</th><td>{asMegapixels(MAX_SINGLE_IMAGE_PIXELS)}</td
          ><td
            >{asMegapixels(MAX_SINGLE_IMAGE_PIXELS)}; the {asMegapixels(mobile.blockedPixels)} total cap
            can block first</td
          >
        </tr>
        {
          !isSplitter && (
            <tr>
              <th scope="row">Batch size warning</th>
              <td>{desktop.warningFiles} files</td>
              <td>{mobile.warningFiles} files</td>
            </tr>
          )
        }
        {
          !isSplitter && (
            <tr>
              <th scope="row">Batch size block</th>
              <td>{desktop.blockedFiles} files</td>
              <td>{mobile.blockedFiles} files</td>
            </tr>
          )
        }
        {
          isSplitter && (
            <tr>
              <th scope="row">Pieces per split</th>
              <td>Up to {MAX_SPLIT_TILES}</td>
              <td>Up to {MAX_SPLIT_TILES}</td>
            </tr>
          )
        }
        <tr
          ><th scope="row">Encoded input warning</th><td>{asMemory(desktop.warningEncodedBytes)}</td
          ><td>{asMemory(mobile.warningEncodedBytes)}</td></tr
        >
        <tr
          ><th scope="row">Encoded input block</th><td>{asMemory(desktop.blockedEncodedBytes)}</td
          ><td>{asMemory(mobile.blockedEncodedBytes)}</td></tr
        >
        <tr
          ><th scope="row">Total pixels warning</th><td>{asMegapixels(desktop.warningPixels)}</td
          ><td>{asMegapixels(mobile.warningPixels)}</td></tr
        >
        <tr
          ><th scope="row">Total pixels block</th><td>{asMegapixels(desktop.blockedPixels)}</td><td
            >{asMegapixels(mobile.blockedPixels)}</td
          ></tr
        >
        <tr
          ><th scope="row">Working memory warning</th><td
            >{asMemory(desktop.warningWorkingBytes)}</td
          ><td>{asMemory(mobile.warningWorkingBytes)}</td></tr
        >
        <tr
          ><th scope="row">Working memory block</th><td>{asMemory(desktop.blockedWorkingBytes)}</td
          ><td>{asMemory(mobile.blockedWorkingBytes)}</td></tr
        >
        <tr>
          <th scope="row">Parallel processing</th>
          <td>Up to 2 {isSplitter ? 'pieces' : 'images'}</td>
          <td>Up to 2 {isSplitter ? 'pieces' : 'images'}</td>
        </tr>
      </tbody>
    </table>
  </div>
  <p class="spec-note">
    Large dimensions can exhaust browser memory before encoded file size looks large. ToolkitFree
    checks dimensions and estimated working memory before processing.
  </p>
</section>
