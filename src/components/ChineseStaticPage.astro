---
import Layout from '../layouts/Layout.astro';
import ImageConverter from './ImageConverter';
import ToolIcon from './ToolIcon.astro';
import { toolRegistry, toPublicUrl } from '../data/tool-registry';
import { guideRegistry } from '../data/guide-registry';
import { SITE_ORGANIZATION } from '../data/organization';
import { chineseTools, chineseGuideLabels, CHINESE_CONTENT_DATE } from '../i18n/pages';
import { chineseArticles } from '../i18n/pages-static';
import { localizePath } from '../i18n/locale';
interface Props {
  path: string;
}
const { path } = Astro.props;
const article = chineseArticles[path];
const home = path === '';
const guides = path === 'guides';
const missing = path === '404';
const guide = guideRegistry.find((entry) => entry.href === `/${path}`);
const title = home
  ? '免费的本地浏览器工具：图片、PDF、二维码与动画'
  : guides
    ? '实用工具使用指南'
    : missing
      ? '页面未找到'
      : article.title;
const description = home
  ? '免费处理图片、PDF、二维码、证件照与动画。所选文件内容在你的设备本地处理，无需注册账户。'
  : guides
    ? '学习选择图片格式、减小文件大小和准备社交平台图片，了解实际能力与限制。'
    : missing
      ? '未找到请求的页面，可以返回 ToolkitFree 首页或选择其他工具。'
      : article.description;
const pageUrl = toPublicUrl(`/zh/${path}`);
const resourceLink = (href: string) =>
  href.startsWith('/') && !/\.[a-z]+$/i.test(href) ? localizePath(href, 'zh') : href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': home
      ? 'WebSite'
      : guide
        ? 'Article'
        : path === 'about'
          ? 'AboutPage'
          : path === 'contact'
            ? 'ContactPage'
            : 'WebPage',
    name: title,
    ...(guide
      ? {
          headline: title,
          dateModified: CHINESE_CONTENT_DATE,
          image: toPublicUrl('/social/toolkitfree-default.png').replace(/\/$/, ''),
          author: { '@type': 'Organization', name: 'ToolkitFree', url: toPublicUrl('/zh/about') },
          publisher: { '@type': 'Organization', name: 'ToolkitFree', url: toPublicUrl('/zh') },
        }
      : {}),
    description,
    url: pageUrl,
    inLanguage: 'zh-CN',
    ...(home || path === 'about'
      ? {
          [home ? 'publisher' : 'mainEntity']: {
            ...SITE_ORGANIZATION,
            description: '免费的浏览器工具，所选文件内容在设备本地处理。',
          },
        }
      : {}),
  },
  ...(article?.faq
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: article.faq.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: { '@type': 'Answer', text: item.answer },
          })),
        },
      ]
    : []),
];
---

<Layout
  title={title}
  description={description}
  canonical={pageUrl}
  structuredData={structuredData}
  noindex={missing}
>
  {
    home ? (
      <>
        <section class="home-hero">
          <div class="home-hero-copy">
            <>
              <p class="hero-kicker">免费 / 本地优先 / 无需账户</p>
              <h1>免费的本地浏览器工具。</h1>
              <p class="hero-summary">
                转换图片、整理
                PDF、生成二维码、调整证件照、导出动画。你选择的文件在自己的设备上处理。
              </p>
              <div class="hero-proof" aria-label="ToolkitFree 的特点">
                <>
                  <span>{toolRegistry.length} 款实用工具</span>
                  <span>无水印</span>
                  <span>本地处理</span>
                </>
              </div>
            </>
          </div>
          <section class="hero-tool-panel" aria-labelledby="start-converting">
            <div class="hero-tool-heading">
              <>
                <div>
                  <>
                    <p class="section-index">从这里开始 / 图片转换</p>
                    <h2 id="start-converting">转换一张图片</h2>
                  </>
                </div>
                <span class="hero-tool-format">JPG / PNG / WebP</span>
              </>
            </div>
            <ImageConverter locale="zh" client:idle={{ timeout: 800 }} />
            <div class="hero-privacy-note">
              <>
                <span class="privacy-signal" aria-hidden="true" />
                <p>
                  <strong>在你的设备上处理。</strong>网站资源仍通过网络加载。
                </p>
              </>
            </div>
            <a class="text-link" href="/zh/tools/image-converter/">
              打开完整转换工具 <span aria-hidden="true">→</span>
            </a>
          </section>
        </section>
        <section class="tool-directory-section" aria-labelledby="all-tools">
          <div class="section-heading-row">
            <>
              <div>
                <>
                  <p class="section-index">{toolRegistry.length} 款专注实用的工具</p>
                  <h2 id="all-tools">选择你要完成的事情</h2>
                </>
              </div>
              <p>图片、文档、二维码、证件照和动画，每个工具解决一件事。</p>
            </>
          </div>
          <section class="tools-grid">
            {toolRegistry.map((tool, index) => (
              <a href={`/zh${tool.href}/`} class="tool-card" data-tool-id={tool.id}>
                <div class="tool-card-topline">
                  <ToolIcon toolId={tool.id} />
                  <span class="tool-card-number">{String(index + 1).padStart(2, '0')}</span>
                </div>
                <h3>{chineseTools[tool.id].name}</h3>
                <p>{chineseTools[tool.id].description}</p>
                <span class="tool-card-action">
                  使用工具 <span aria-hidden="true">→</span>
                </span>
              </a>
            ))}
          </section>
        </section>
        <section class="home-info-grid">
          <>
            <article>
              <>
                <p class="section-index">为什么选择 ToolkitFree</p>
                <h2>能力和限制，都说清楚。</h2>
                <ul class="features-list">
                  <>
                    <li>免费使用，无需注册工具账户</li>
                    <li>所选文件不上传进行处理</li>
                    <li>根据设备检查内存与处理资源</li>
                    <li>输出不添加水印</li>
                  </>
                </ul>
              </>
            </article>
            <article>
              <>
                <p class="section-index">如何工作</p>
                <h2>让浏览器完成处理。</h2>
                <p>
                  ToolkitFree 使用 Canvas、客户端 JavaScript 和
                  WebAssembly。实际容量取决于设备内存、浏览器限制及编码支持。背景移除和视频转换会按需下载额外的模型或运行时。
                </p>
              </>
            </article>
          </>
        </section>
        <section class="features-section">
          <>
            <h2>从指南开始</h2>
            <div class="related-guides-grid">
              {guideRegistry.map((entry) => (
                <a class="guide-card" href={`/zh${entry.href}/`}>
                  <h3>{chineseGuideLabels[entry.id].title}</h3>
                  <p>{chineseGuideLabels[entry.id].description}</p>
                </a>
              ))}
            </div>
          </>
        </section>
      </>
    ) : guides ? (
      <>
        <>
          <section class="hero">
            <>
              <h1>{title}</h1>
              <p>{description}</p>
            </>
          </section>
          <div class="related-guides-grid">
            {guideRegistry.map((entry) => (
              <a class="guide-card" href={`/zh${entry.href}/`}>
                <h2>{chineseGuideLabels[entry.id].title}</h2>
                <p>{chineseGuideLabels[entry.id].description}</p>
              </a>
            ))}
          </div>
        </>
      </>
    ) : missing ? (
      <section class="hero">
        <>
          <h1>404：页面未找到</h1>
          <p>{description}</p>
          <a href="/zh/" class="btn btn-primary">
            返回首页
          </a>
        </>
      </section>
    ) : (
      <article class={guide ? 'guide-page' : 'legal-page'}>
        <>
          <h1>{title}</h1>
          <p class="page-intro">{description}</p>
        </>
        {['terms', 'privacy-policy'].includes(path) && (
          <p class="last-updated">
            最近更新：<time datetime={CHINESE_CONTENT_DATE}>{CHINESE_CONTENT_DATE}</time>
          </p>
        )}
        {article.sections.map((section) => (
          <section class="features-section">
            <h2>{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.items && (
              <ul class="features-list">
                {section.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
            {section.links && (
              <ul class="article-links">
                {section.links.map((link) => (
                  <li>
                    <a href={resourceLink(link.href)}>{link.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
        {path === 'about' && (
          <section class="features-section">
            <h2>全部工具</h2>
            <div class="related-tools-grid" data-tool-directory="about">
              {toolRegistry.map((tool) => (
                <a class="tool-card" data-tool-id={tool.id} href={`/zh${tool.href}/`}>
                  <h3>{chineseTools[tool.id].name}</h3>
                  <p>{chineseTools[tool.id].description}</p>
                </a>
              ))}
            </div>
          </section>
        )}
        {article.faq && (
          <section class="faq-section">
            <h2>常见问题</h2>
            {article.faq.map((item) => (
              <div class="faq-item">
                <details>
                  <summary class="faq-question">{item.question}</summary>
                  <div class="faq-answer">{item.answer}</div>
                </details>
              </div>
            ))}
          </section>
        )}
        {guide && (
          <section class="related-tools">
            <h2>相关工具</h2>
            <div class="related-tools-grid">
              {guide.relatedTools.map((id) => (
                <a class="tool-card" href={`/zh/tools/${id}/`} data-tool-id={id}>
                  <h3>{chineseTools[id].name}</h3>
                  <p>{chineseTools[id].description}</p>
                </a>
              ))}
            </div>
          </section>
        )}
      </article>
    )
  }
</Layout>
<style>
  .page-intro {
    color: var(--color-text-light);
    margin-bottom: 1.5rem;
  }
  .features-section p + p {
    margin-top: 0.75rem;
  }
  .article-links {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
  }
  .article-links li {
    padding: 0.25rem 0;
  }
  .guide-page {
    max-width: 900px;
    margin: auto;
  }
</style>
