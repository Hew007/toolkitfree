---
import '../styles/global.css';
import { getLocale, stripLocale, localizePath } from '../i18n/locale';
import {
  chineseTools,
  chineseVariants,
  chineseGuideLabels,
  CHINESE_CONTENT_DATE,
} from '../i18n/pages';
import { SITE_ORGANIZATION } from '../data/organization';
import '../styles/responsive-accessibility.css';
import { guideRegistry } from '../data/guide-registry';
import {
  navigationGroups,
  SITE_URL,
  toPublicPath,
  toPublicUrl,
  toolRegistry,
} from '../data/tool-registry';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  structuredData?: object;
  noindex?: boolean;
}

const { title, description, canonical, ogImage, structuredData, noindex = false } = Astro.props;

const locale = getLocale(Astro.url.pathname);
const zh = locale === 'zh';
const t = (en: string, cn: string) => (zh ? cn : en);
const pagePath = (path: string) => localizePath(toPublicPath(path), locale);
const siteName = 'ToolkitFree';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonicalTarget = new URL(canonical ?? Astro.url.pathname, SITE_URL);
canonicalTarget.pathname = toPublicPath(canonicalTarget.pathname);
const canonicalUrl = canonicalTarget.toString();
const socialImageUrl = new URL(ogImage ?? '/social/toolkitfree-default.png', SITE_URL).toString();
const currentPath = stripLocale(Astro.url.pathname).replace(/\/$/, '') || '/';
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
const currentTool = toolRegistry.find(
  (tool) => currentPath === tool.href || currentPath.startsWith(`${tool.href}/`)
);
const currentVariant = currentTool?.variants.find(
  (variant) => currentPath === `${currentTool.href}/${variant.slug}`
);
const currentGuide = guideRegistry.find((guide) => currentPath === guide.href);
const staticPageLabels: Record<string, string> = {
  '/about': 'About',
  '/contact': 'Contact',
  '/guides': 'Guides',
  '/privacy-policy': 'Privacy Policy',
  '/terms': 'Terms',
};
const breadcrumbs =
  currentPath === '/'
    ? []
    : currentTool
      ? [
          { label: 'Home', href: '/' },
          { label: currentTool.name, href: toPublicPath(currentTool.href) },
          ...(currentVariant ? [{ label: currentVariant.label }] : []),
        ]
      : currentGuide
        ? [
            { label: 'Home', href: '/' },
            { label: 'Guides', href: '/guides/' },
            { label: currentGuide.title },
          ]
        : [{ label: 'Home', href: '/' }, { label: staticPageLabels[currentPath] ?? title }];
const breadcrumbLabel = (label: string) => {
  if (!zh) return label;
  if (label === 'Home') return '首页';
  if (label === 'Guides') return '使用指南';
  if (currentTool && label === currentTool.name) return chineseTools[currentTool.id].name;
  if (currentVariant && label === currentVariant.label)
    return chineseVariants[currentVariant.slug].name;
  if (currentGuide && label === currentGuide.title)
    return chineseGuideLabels[currentGuide.id].title;
  return (
    (
      { About: '关于', Contact: '联系', 'Privacy Policy': '隐私政策', Terms: '服务条款' } as Record<
        string,
        string
      >
    )[label] ?? label
  );
};
const pageLastModified =
  zh && (currentTool || currentGuide)
    ? CHINESE_CONTENT_DATE
    : (currentTool?.lastModified ?? currentGuide?.lastModified);
const freshnessSchema =
  pageLastModified && !currentGuide
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        url: canonicalUrl,
        dateModified: pageLastModified,
      }
    : undefined;

const normalizeStructuredUrls = (value: unknown): unknown => {
  if (Array.isArray(value)) return value.map(normalizeStructuredUrls);
  if (!value || typeof value !== 'object') return value;

  return Object.fromEntries(
    Object.entries(value).map(([key, entry]) => {
      if (
        (key === 'url' || key === 'item') &&
        typeof entry === 'string' &&
        (entry === SITE_URL || entry.startsWith(`${SITE_URL}/`))
      ) {
        const url = new URL(entry);
        url.pathname = toPublicPath(url.pathname);
        return [key, url.toString()];
      }
      return [key, normalizeStructuredUrls(entry)];
    })
  );
};
const enrichGuideArticle = (value: unknown): unknown => {
  if (Array.isArray(value)) return value.map(enrichGuideArticle);
  if (!value || typeof value !== 'object') return value;

  const entry = value as Record<string, unknown>;
  const nested = Object.fromEntries(
    Object.entries(entry).map(([key, child]) => [key, enrichGuideArticle(child)])
  );
  if (currentGuide && entry['@type'] === 'Article') {
    return {
      ...nested,
      dateModified: pageLastModified,
      image: socialImageUrl,
      author: { '@type': 'Organization', name: siteName, url: toPublicUrl(pagePath('/about')) },
      publisher: { '@type': 'Organization', name: siteName, url: toPublicUrl(pagePath('/')) },
    };
  }
  return nested;
};
const normalizedStructuredData = enrichGuideArticle(normalizeStructuredUrls(structuredData));

// Every page carries the site's identity, and it has to be the same identity the
// homepage names as its publisher and the About page names as its subject —
// otherwise the site tells a crawler two different stories about one entity.
// Spread from the single definition rather than restating it; this block used to
// carry its own description and drifted into claiming image tools only.
const orgSchema = {
  '@context': 'https://schema.org',
  ...SITE_ORGANIZATION,
  ...(zh
    ? {
        description:
          '免费的浏览器图片、PDF、二维码、证件照与动画工具，所选文件内容在设备本地处理。',
      }
    : {}),
  logo: new URL('/brand/toolkitfree-mark.svg', SITE_URL).toString(),
};
---

<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <title>{fullTitle}</title>

    <link rel="canonical" href={canonicalUrl} />
    {
      !noindex && currentPath !== '/404' && (
        <>
          <link
            rel="alternate"
            hreflang="en"
            href={toPublicUrl(localizePath(toPublicPath(currentPath), 'en'))}
          />
          <link
            rel="alternate"
            hreflang="zh-CN"
            href={toPublicUrl(localizePath(toPublicPath(currentPath), 'zh'))}
          />
          <link
            rel="alternate"
            hreflang="x-default"
            href={toPublicUrl(localizePath(toPublicPath(currentPath), 'en'))}
          />
        </>
      )
    }
    <meta property="og:locale" content={zh ? 'zh_CN' : 'en_US'} />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteName} — ${title}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={`${siteName} — ${title}`} />

    <meta name="yandex-verification" content="a605e0322d8c1403" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {
      normalizedStructuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(normalizedStructuredData)} />
      )
    }
    {
      freshnessSchema && (
        <script type="application/ld+json" set:html={JSON.stringify(freshnessSchema)} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t('Skip to main content', '跳到主要内容')}</a>

    <header class="site-header">
      <div class="container">
        <a
          href={pagePath('/')}
          class="site-logo"
          aria-label={t('ToolkitFree home', 'ToolkitFree 首页')}
        >
          <img src="/brand/toolkitfree-mark.svg" width="32" height="32" alt="" aria-hidden="true" />
          <span>{siteName}</span>
        </a>
        <button
          class="mobile-nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-navigation"
        >
          {t('Menu', '菜单')}
        </button>
        <nav
          id="primary-navigation"
          class="site-nav"
          aria-label={t('Primary navigation', '主导航')}
        >
          {
            navigationGroups.map((group) => (
              <details class="nav-menu-group">
                <summary>
                  {zh ? (group.label === 'Image tools' ? '图片工具' : '创作与导出') : group.label}
                </summary>
                <div class="nav-menu-panel">
                  {group.links.map((link) => (
                    <a
                      href={pagePath(link.href)}
                      data-tool-id={link.id}
                      aria-current={isCurrent(link.href) ? 'page' : undefined}
                    >
                      {zh ? chineseTools[link.id].name : link.label}
                    </a>
                  ))}
                </div>
              </details>
            ))
          }
        </nav>
        <a
          class="language-switch"
          href={currentPath === '/404' && zh
            ? '/'
            : localizePath(toPublicPath(currentPath), zh ? 'en' : 'zh')}
          lang={zh ? 'en' : 'zh-CN'}
          hreflang={zh ? 'en' : 'zh-CN'}
          aria-label={t('Switch this page to Chinese', '将此页面切换为英文')}
          >{zh ? 'English' : '中文'}</a
        >
      </div>
    </header>

    <main id="main-content" class="site-main" tabindex="-1">
      <div class="container">
        {
          breadcrumbs.length > 0 && (
            <nav class="breadcrumbs" aria-label={t('Breadcrumb', '当前位置')}>
              <ol>
                {breadcrumbs.map((item, index) => (
                  <li>
                    {'href' in item && item.href && index < breadcrumbs.length - 1 ? (
                      <a href={pagePath(item.href)}>{breadcrumbLabel(item.label)}</a>
                    ) : (
                      <span aria-current="page">{breadcrumbLabel(item.label)}</span>
                    )}
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <slot />
        {
          pageLastModified && (
            <p class="page-updated">
              {t('Last reviewed', '最近检查')}{' '}
              <time datetime={pageLastModified}>{pageLastModified}</time>
            </p>
          )
        }
      </div>
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-links" data-tool-directory="footer">
            {
              toolRegistry.map((tool) => (
                <a href={pagePath(tool.href)} data-tool-id={tool.id}>
                  {zh ? chineseTools[tool.id].name : tool.name}
                </a>
              ))
            }
          </div>
          <div class="footer-links">
            <a href={pagePath('/guides')}>{t('Guides', '使用指南')}</a>
            <a href={pagePath('/about')}>{t('About', '关于')}</a>
            <a href={pagePath('/terms')}>{t('Terms', '服务条款')}</a>
            <a href={pagePath('/privacy-policy')}>{t('Privacy', '隐私政策')}</a>
            <a href={pagePath('/contact')}>{t('Contact', '联系')}</a>
            {
              /* The machine-readable site summary. It only helps if something can
                find it, and a link in the footer is the one place every page has. */
            }
            <a href="/llms.txt">llms.txt</a>
          </div>
          <p class="footer-copy">
            &copy; {new Date().getFullYear()}
            {siteName}. {t('All rights reserved.', '保留所有权利。')}
          </p>
        </div>
      </div>
    </footer>

    <script>
      const header = document.querySelector<HTMLElement>('.site-header');
      const toggle = document.querySelector<HTMLButtonElement>('.mobile-nav-toggle');
      const navigation = document.querySelector<HTMLElement>('#primary-navigation');
      const menuGroups = [...document.querySelectorAll<HTMLDetailsElement>('.nav-menu-group')];

      const closeNavigation = (returnFocus = false) => {
        navigation?.removeAttribute('data-open');
        toggle?.setAttribute('aria-expanded', 'false');
        menuGroups.forEach((group) => group.removeAttribute('open'));
        if (returnFocus) toggle?.focus();
      };

      toggle?.addEventListener('click', () => {
        const opening = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(opening));
        navigation?.toggleAttribute('data-open', opening);
        if (opening) navigation?.querySelector<HTMLElement>('summary')?.focus();
      });

      menuGroups.forEach((group) => {
        group.addEventListener('toggle', () => {
          if (!group.open) return;
          menuGroups.forEach((otherGroup) => {
            if (otherGroup !== group) otherGroup.removeAttribute('open');
          });
        });
      });

      navigation?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => closeNavigation());
      });

      document.addEventListener('click', (event) => {
        if (header && !header.contains(event.target as Node)) closeNavigation();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key !== 'Escape') return;
        const openGroup = menuGroups.find((group) => group.open);
        if (toggle?.getAttribute('aria-expanded') === 'true') closeNavigation(true);
        else if (openGroup) {
          openGroup.removeAttribute('open');
          openGroup.querySelector<HTMLElement>('summary')?.focus();
        }
      });
    </script>
  </body>
</html>

<style>
  .language-switch {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0.5rem 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    font-size: 0.875rem;
    white-space: nowrap;
  }
  @media (max-width: 767px) {
    .language-switch {
      margin-left: auto;
    }
    .mobile-nav-toggle {
      order: 3;
    }
  }
</style>
