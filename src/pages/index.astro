---
import ImageConverter from '../components/ImageConverter';
import ToolIcon from '../components/ToolIcon.astro';
import { toPublicPath, toolRegistry } from '../data/tool-registry';
import Layout from '../layouts/Layout.astro';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ToolkitFree',
  description:
    'Free browser tools for images, PDFs, QR codes, ID photos, and animated media with local file-content processing.',
  url: 'https://toolkitfree.net',
};
---

<Layout
  title="Free Browser Tools for Images, PDFs, QR Codes & More"
  description="Free browser tools for images, PDFs, QR codes, ID photos, and animated media. Selected file contents are processed locally on your device."
  structuredData={structuredData}
>
  <section class="home-hero">
    <div class="home-hero-copy">
      <p class="hero-kicker">Free / local-first / no account</p>
      <h1>Work with files. Keep them private.</h1>
      <p class="hero-summary">
        Convert images, prepare PDFs, create QR codes, size ID photos, and export animated media.
        Your selected files stay on your device while you work.
      </p>
      <div class="hero-proof" aria-label="ToolkitFree benefits">
        <span>13 focused tools</span><span>No watermark</span><span>Local processing</span>
      </div>
    </div>

    <section class="hero-tool-panel" aria-labelledby="start-converting">
      <div class="hero-tool-heading">
        <div>
          <p class="section-index">Start here / Image converter</p>
          <h2 id="start-converting">Convert an image</h2>
        </div>
        <span class="hero-tool-format">JPG / PNG / WebP</span>
      </div>
      <ImageConverter client:load />
      <div class="hero-privacy-note">
        <span class="privacy-signal" aria-hidden="true"></span>
        <p>
          <strong>Processed on your device.</strong> Normal site assets still load from the network.
        </p>
      </div>
      <a href="/tools/image-converter/" class="text-link"
        >Open the full converter <span aria-hidden="true">&rarr;</span></a
      >
    </section>
  </section>

  <section class="tool-directory-section" aria-labelledby="all-tools">
    <div class="section-heading-row">
      <div>
        <p class="section-index">13 focused utilities</p>
        <h2 id="all-tools">Choose the job you need</h2>
      </div>
      <p>Images, documents, codes, photos, and motion. One clear tool at a time.</p>
    </div>
    <section class="tools-grid">
      {
        toolRegistry.map((tool, index) => (
          <a href={toPublicPath(tool.href)} class="tool-card" data-tool-id={tool.id}>
            <div class="tool-card-topline">
              <ToolIcon toolId={tool.id} />
              <span class="tool-card-number">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <h3>{tool.name}</h3>
            <p>{tool.description}</p>
            <span class="tool-card-action">
              Use tool <span aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))
      }
    </section>
  </section>

  <section class="home-info-grid">
    <article>
      <p class="section-index">Why ToolkitFree</p>
      <h2>Useful constraints, stated plainly.</h2>
      <ul class="features-list">
        <li>Free to use, with no tool account required</li>
        <li>Selected files are not uploaded for processing</li>
        <li>Device-aware browser memory and resource safeguards</li>
        <li>No watermarks on output</li>
      </ul>
    </article>
    <article>
      <p class="section-index">How it works</p>
      <h2>Your browser does the work.</h2>
      <p>
        ToolkitFree uses Canvas, client-side JavaScript, and WebAssembly. Capacity depends on device
        memory, browser limits, and codec support. Background removal and video conversion load
        additional model or runtime resources when needed.
      </p>
    </article>
  </section>

  <section class="popular-paths" aria-labelledby="popular-paths-heading">
    <div class="section-heading-row">
      <div>
        <p class="section-index">Quick paths</p>
        <h2 id="popular-paths-heading">Popular starting points</h2>
      </div>
      <p>Go straight to a common format or outcome.</p>
    </div>
    <div class="popular-paths-grid">
      <a href="/tools/image-converter/jpg-to-png/">
        <span>JPG to PNG</span><small>Convert for compatibility</small><b aria-hidden="true"
          >&rarr;</b
        >
      </a>
      <a href="/tools/image-compressor/compress-for-web/">
        <span>Compress for web</span><small>Reduce and compare file size</small><b
          aria-hidden="true">&rarr;</b
        >
      </a>
      <a href="/tools/image-resizer/resize-for-instagram/">
        <span>Resize for Instagram</span><small>Use ready-made dimensions</small><b
          aria-hidden="true">&rarr;</b
        >
      </a>
      <a href="/tools/image-cropper/crop-to-square/">
        <span>Crop to square</span><small>Frame a clean 1:1 image</small><b aria-hidden="true"
          >&rarr;</b
        >
      </a>
      <a href="/tools/image-to-pdf/jpg-to-pdf/">
        <span>JPG to PDF</span><small>Combine images into a PDF</small><b aria-hidden="true"
          >&rarr;</b
        >
      </a>
      <a href="/tools/background-remover/">
        <span>Remove background</span><small>Create a transparent image</small><b aria-hidden="true"
          >&rarr;</b
        >
      </a>
    </div>
  </section>
</Layout>
