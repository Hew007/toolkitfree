---
import Layout from '../layouts/Layout.astro';
import { toPublicPath, toolRegistry } from '../data/tool-registry';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About ToolkitFree',
  description: 'Free browser-based tools that process selected file contents locally.',
  url: 'https://toolkitfree.net/about',
  mainEntity: {
    '@type': 'Organization',
    name: 'ToolkitFree',
    url: 'https://toolkitfree.net',
    description:
      'Free browser-based tools for images, PDFs, QR codes, ID photos, and animated media. Selected file contents are processed locally on the device.',
  },
};
---

<Layout
  title="About Us - Free, Privacy-First Browser Tools"
  description="ToolkitFree provides free tools that process file contents in your browser without uploading those files. Site assets, ads, and optional models still use network requests."
  canonical="https://toolkitfree.net/about"
  structuredData={structuredData}
>
  <section class="hero">
    <h1>Your Browser Is the Only Tool You Need.</h1>
    <p>
      Free tools for images, PDFs, QR codes, ID photos, and animated media. Selected file contents
      are processed locally on your device.
    </p>
    <div class="privacy-badge">Privacy-First by Design</div>
  </section>

  <section class="features-section">
    <h2>What We Do</h2>
    <p style="color: var(--color-text-light); line-height: 1.8;">
      ToolkitFree is a free, browser-based toolkit that processes selected file contents on your
      device without uploading them to ToolkitFree for processing. The tools do not require an
      account, while the website still loads the resources needed to provide the page.
    </p>
    <p style="color: var(--color-text-light); line-height: 1.8; margin-top: 1rem;">
      The current toolkit covers image conversion and editing, PDF creation and page extraction, QR
      codes, ID photo preparation, favicons, and short video or animated-image conversion.
    </p>
  </section>

  <section class="features-section">
    <h2>Core Principles</h2>
    <ul class="features-list">
      <li>Free to use, with no tool account required</li>
      <li>Selected file contents are not uploaded for processing</li>
      <li>Local processing with clear browser and device limits</li>
      <li>Device-aware file, pixel, page, frame, and memory safeguards</li>
      <li>No watermarks on output</li>
      <li>Designed for modern desktop and mobile browsers</li>
    </ul>
  </section>

  <section class="features-section">
    <h2>How It Works</h2>
    <p style="color: var(--color-text-light); line-height: 1.8;">
      ToolkitFree processing uses browser technologies including Canvas, client-side JavaScript, and
      WebAssembly. Selected file contents are processed locally and are not uploaded to ToolkitFree
      for processing. Capacity depends on memory, codecs, and browser limits. Pages still load site
      assets and advertising resources; background removal downloads a model, and video conversion
      loads a site-hosted FFmpeg runtime when needed.
    </p>
  </section>

  <section class="features-section">
    <h2>Our Tools</h2>
    <div class="related-tools-grid" data-tool-directory="about">
      {
        toolRegistry.map((tool) => (
          <a href={toPublicPath(tool.href)} class="tool-card" data-tool-id={tool.id}>
            <h3>{tool.name}</h3>
            <p>{tool.shortDescription}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="features-section">
    <h2>What's Next</h2>
    <p style="color: var(--color-text-light); line-height: 1.8;">
      The roadmap focuses on practical browser utilities, clearer compatibility guidance, better
      mobile workflows, and evidence-led improvements to existing tools. Additional languages may be
      considered after the English experience and support material are mature.
    </p>
  </section>

  <section class="features-section">
    <h2>Privacy Boundaries</h2>
    <p style="color: var(--color-text-light); line-height: 1.8;">
      File contents selected for processing are handled locally and are not collected or stored by
      ToolkitFree for processing. Website hosting, traffic measurement, advertising, and optional
      model or runtime downloads still involve network requests and are described in our Privacy
      Policy.
    </p>
    <p style="color: var(--color-text-light); line-height: 1.8; margin-top: 1rem;">
      For more details, see our <a href="/privacy-policy/">Privacy Policy</a> and
      <a href="/terms/">Terms of Service</a>.
    </p>
  </section>

  <section class="features-section" style="margin-bottom: 2rem;">
    <h2>Get in Touch</h2>
    <p style="color: var(--color-text-light); line-height: 1.8;">
      Have questions, feedback, or ideas? We'd love to hear from you. Reach out at <a
        href="mailto:hnhw182@gmail.com">hnhw182@gmail.com</a
      > or visit our
      <a href="/contact/">Contact</a> page.
    </p>
  </section>
</Layout>
