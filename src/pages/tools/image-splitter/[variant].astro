---
import Layout from '../../../layouts/Layout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import ProcessingLimits from '../../../components/ProcessingLimits.astro';
import ImageSplitter from '../../../components/ImageSplitter';
import { allVariants, variantData } from '../../../data/splitter-variants';
import { toPublicUrl } from '../../../data/tool-registry';

export function getStaticPaths() {
  return allVariants.map((variant) => ({
    params: { variant: variant.slug },
    props: {
      slug: variant.slug,
      ...variantData[variant.slug],
    },
  }));
}

const { title, description, intro, features, defaultRows, defaultCols, faq, slug } = Astro.props;

const pageUrl = toPublicUrl(`/tools/image-splitter/${Astro.params.variant}`);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description: description,
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: toPublicUrl('/') },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Image Splitter',
      item: toPublicUrl('/tools/image-splitter'),
    },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title={title}
  description={description}
  canonical={pageUrl}
  ogImage="/social/image-splitter.png"
  structuredData={[structuredData, faqStructuredData, breadcrumbSchema]}
>
  <div class="tool-layout">
    <div class="tool-content">
      <h1>{title}</h1>
      <p style="color: var(--color-text-light); margin-bottom: 0.5rem;">{description}</p>
      <div class="privacy-badge">Image processing stays on this device</div>

      <div style="margin-top: 1.5rem;">
        <ImageSplitter client:load defaultRows={defaultRows} defaultCols={defaultCols} />
      </div>

      <section class="features-section">
        <h2>How This Split Works</h2>
        <p style="color: var(--color-text-light);">{intro}</p>
      </section>

      <section class="features-section">
        <h2>Features</h2>
        <ul class="features-list">
          {features.map((feature: string) => <li>{feature}</li>)}
        </ul>
      </section>

      <ProcessingLimits profile="splitter" />

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {
          faq.map((item: { question: string; answer: string }) => (
            <div class="faq-item">
              <details>
                <summary class="faq-question">{item.question}</summary>
                <div class="faq-answer">{item.answer}</div>
              </details>
            </div>
          ))
        }
      </section>

      <section class="related-tools">
        <h2>More Ways to Split</h2>
        <div class="related-tools-grid">
          {
            allVariants
              .filter((variant) => variant.slug !== slug)
              .map((variant) => (
                <a href={`/tools/image-splitter/${variant.slug}/`} class="tool-card">
                  <h3>{variant.label}</h3>
                </a>
              ))
          }
          <a href="/tools/image-splitter/" class="tool-card">
            <h3>All Splitting Options</h3>
          </a>
        </div>
      </section>

      <ToolDirectory currentId="image-splitter" mode="related" />
    </div>

    <aside class="tool-sidebar">
      <div>
        <h3 style="font-size: 1rem; margin-bottom: 0.75rem;">Other Splits</h3>
        <ul style="font-size: 0.875rem; list-style: none;">
          {
            allVariants.map((variant) => (
              <li style="padding: 0.25rem 0;">
                <a href={`/tools/image-splitter/${variant.slug}/`}>{variant.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <ToolDirectory currentId="image-splitter" mode="sidebar" />
    </aside>
  </div>
</Layout>
