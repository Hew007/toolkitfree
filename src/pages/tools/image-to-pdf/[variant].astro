---
import Layout from '../../../layouts/Layout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import ImageToPdf from '../../../components/ImageToPdf';
import { allVariants, variantData } from '../../../data/pdf-variants';
import { PDF_VARIANT_PRESETS, type PdfVariantSlug } from '../../../lib/image-to-pdf';

export function getStaticPaths() {
  return allVariants.map((v) => ({
    params: { variant: v.slug },
    props: { slug: v.slug, ...variantData[v.slug] },
  }));
}

const { title, description, faq, slug } = Astro.props;
const presetKey = PDF_VARIANT_PRESETS[slug as PdfVariantSlug];

// Steps for the preset this page opens on: its input filter, page size and margin.
const noMargin = presetKey === 'no_margin';
const inputNoun =
  presetKey === 'jpg'
    ? 'JPG images'
    : presetKey === 'png'
      ? 'PNG images'
      : presetKey === 'photo'
        ? 'photos'
        : 'images';
const howToHeading = {
  'jpg-to-pdf': 'How to Convert JPG to PDF',
  'png-to-pdf': 'How to Convert PNG to PDF',
  'image-to-a4-pdf': 'How to Make an A4 PDF From Images',
  'multiple-images-to-pdf': 'How to Combine Multiple Images Into One PDF',
  'image-to-pdf-no-margin': 'How to Make a PDF With No Margins',
  'photo-to-pdf': 'How to Convert Photos to PDF',
}[slug as string];

const pageUrl = `https://toolkitfree.net/tools/image-to-pdf/${Astro.params.variant}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description: description,
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toolkitfree.net' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Image to PDF',
      item: 'https://toolkitfree.net/tools/image-to-pdf',
    },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title={title}
  description={description}
  canonical={pageUrl}
  structuredData={[structuredData, faqStructuredData, breadcrumbSchema]}
>
  <div class="tool-layout">
    <div class="tool-content">
      <h1>{title}</h1>
      <p style="color: var(--color-text-light); margin-bottom: 1.5rem;">
        {description}
      </p>

      <div class="privacy-badge">
        <span style="color: #10b981; font-weight: 600;"
          >Selected file contents are processed in your browser</span
        >
      </div>

      <ImageToPdf client:load defaultPreset={presetKey} />

      <section class="howto-section">
        <h2>{howToHeading}</h2>
        <ol class="howto-steps">
          <li>
            Upload one or more {inputNoun} — each one becomes a page you can see straight away
          </li>
          {
            noMargin ? (
              <li>
                Fit to image is already selected with no margin, so each page is exactly the size of
                its image
              </li>
            ) : (
              <li>
                Pages start at A4 portrait with a 10 mm margin — choose Letter or Fit to image, and
                change orientation and margin under Fine-tune
              </li>
            )
          }
          {
            presetKey === 'multiple' ? (
              <li>
                Drop an image onto another page to put several on one page, or between two pages to
                give it a page of its own; reorder pages with the arrows in each page heading
              </li>
            ) : (
              <li>Drag an image to move it, drag a corner to resize it, or rotate it 90&deg;</li>
            )
          }
          <li>Download the PDF — it is rebuilt as you edit, so it always matches the editor</li>
        </ol>
      </section>

      <section class="features-section">
        <h2>Features</h2>
        <ul class="features-list">
          <li>Combine multiple images into one PDF</li>
          <li>A4 and US Letter page sizes</li>
          <li>Adjustable margins</li>
          <li>Portrait and landscape orientation</li>
          <li>Selected image contents are processed locally in your browser</li>
        </ul>
      </section>

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {
          faq.map((item: { question: string; answer: string }) => (
            <div class="faq-item">
              <details>
                <summary class="faq-question">{item.question}</summary>
                <div class="faq-answer">{item.answer}</div>
              </details>
            </div>
          ))
        }
      </section>

      <section class="related-tools">
        <h2>More PDF Tools</h2>
        <div class="related-tools-grid">
          {
            allVariants
              .filter((v) => v.slug !== slug)
              .map((v) => (
                <a href={`/tools/image-to-pdf/${v.slug}/`} class="tool-card">
                  <h3>{v.label}</h3>
                </a>
              ))
          }
        </div>
      </section>
    </div>

    <aside class="tool-sidebar">
      <ToolDirectory currentId="image-to-pdf" mode="sidebar" />
    </aside>
  </div>
</Layout>
