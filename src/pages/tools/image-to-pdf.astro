---
import Layout from '../../layouts/Layout.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import ImageToPdf from '../../components/ImageToPdf';

const faqItems = [
  {
    question: 'How do I convert images to PDF?',
    answer:
      'Upload one or more images and each becomes a page you can see immediately. Choose page size (A4, Letter, or fit to image), set orientation and margins, adjust any image on its page, then click "Create PDF." The downloaded file matches the preview exactly.',
  },
  {
    question: 'Can I move, resize, or rotate an image before converting?',
    answer:
      'Yes. Drag an image to reposition it on its page, drag a corner handle to resize it, and use the rotate buttons for 90-degree turns. Fit page, Fill page, and Actual size shortcuts are also available, and Reset layout returns every image to the automatic arrangement.',
  },
  {
    question: 'Can I put more than one image on the same page?',
    answer:
      'Yes. Drag an image onto another page and both are arranged on that page automatically. Each image can then be moved and resized independently. By default every image gets its own page.',
  },
  {
    question: 'Can I use the editor without a mouse?',
    answer:
      'Yes. Focus an image and use the arrow keys to move it, Alt plus the arrow keys to resize it, the bracket keys to rotate it, Ctrl plus the arrow keys to reorder it on the page, and Alt plus PageUp or PageDown to move it to another page. Hold Shift for larger steps.',
  },
  {
    question: 'Is this image to PDF converter free?',
    answer:
      'Yes, it is free with no sign-up or watermark. Browser memory and PDF generation limits still apply to large images and batches.',
  },
  {
    question: 'Are my images uploaded to a server?',
    answer:
      'No. All PDF generation happens entirely in your browser using the jsPDF library. Your images never leave your device.',
  },
  {
    question: 'Can I combine multiple images into one PDF?',
    answer:
      'Yes. Upload multiple images and they are combined into a single multi-page PDF. Each image starts on its own page, and you can drop images together to share a page.',
  },
  {
    question: 'What page sizes are supported?',
    answer:
      'We support A4 (210×297mm), US Letter (8.5×11"), and "Fit to Image" which creates a page matching each image\'s exact dimensions.',
  },
  {
    question: 'What image formats can I convert?',
    answer:
      'JPG, PNG, and WebP are supported. HEIC and TIFF are not supported by the current converter.',
  },
  {
    question: 'Can I adjust margins?',
    answer:
      'Yes. You can set margins from 0mm to 30mm. Set to 0 or choose "Fit to Image" for edge-to-edge images.',
  },
  {
    question: 'How is this different from other online converters?',
    answer:
      'ToolkitFree generates the PDF locally without uploading image files. The page must first load its site resources, and browser memory limits still apply.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Free Image to PDF Converter',
  description:
    'Convert images to PDF online. Supports JPG, PNG, WebP. Combine multiple images into one PDF. A4, Letter, custom page sizes. 100% client-side.',
  url: 'https://toolkitfree.net/tools/image-to-pdf',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toolkitfree.net' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Image to PDF',
      item: 'https://toolkitfree.net/tools/image-to-pdf',
    },
  ],
};
---

<Layout
  title="Image to PDF — Convert Images Online Free | ToolkitFree"
  description="Convert images to PDF online with a live page editor. Move, resize, and rotate each image, or place several on one page. JPG, PNG, WebP. Free, no upload needed."
  structuredData={[
    structuredData,
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
    breadcrumbSchema,
  ]}
>
  <div class="tool-layout">
    <div class="tool-content">
      <h1>Free Online Image to PDF Converter</h1>
      <p style="color: var(--color-text-light); margin-bottom: 1.5rem;">
        Convert JPG, PNG, and WebP images to PDF and see every page before you export it. Move,
        resize, and rotate each image, or drop several onto one page. All processing in your
        browser.
      </p>

      <div class="privacy-badge">
        <span style="color: #10b981; font-weight: 600;">Your files never leave your device</span>
      </div>

      <ImageToPdf client:load />

      <section class="howto-section">
        <h2>How to Convert Images to PDF</h2>
        <ol class="howto-steps">
          <li>Upload one or more images — each one becomes a page you can see straight away</li>
          <li>Choose page size (A4, Letter, or Fit to Image), orientation, and margins</li>
          <li>Drag an image to move it, drag a corner to resize it, or rotate it 90&deg;</li>
          <li>Drop an image onto another page to put several images on one page</li>
          <li>Click "Create PDF" and download — the file matches the preview exactly</li>
        </ol>
      </section>

      <section class="features-section">
        <h2>Features</h2>
        <ul class="features-list">
          <li>Live page preview — what you see is what gets exported</li>
          <li>Move, resize, and rotate each image on its page</li>
          <li>Put several images on a single page, or one per page</li>
          <li>Full keyboard control for every editing action</li>
          <li>A4 and US Letter page sizes, plus fit-to-image for exact dimensions</li>
          <li>Portrait and landscape orientation, adjustable margins (0-30mm)</li>
          <li>Supports JPG, PNG, and WebP inputs</li>
          <li>100% client-side — your images never leave your device</li>
        </ul>
      </section>

      <div style="margin: 2rem 0;">
        <div class="ad-placeholder ad-banner">Ad Space (728x90)</div>
      </div>

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {
          faqItems.map((item) => (
            <div class="faq-item">
              <details>
                <summary class="faq-question">{item.question}</summary>
                <div class="faq-answer">{item.answer}</div>
              </details>
            </div>
          ))
        }
      </section>

      <ToolDirectory currentId="image-to-pdf" mode="related" />
    </div>
    <aside class="tool-sidebar">
      <div class="ad-placeholder ad-sidebar">Ad Space (300x250)</div>
      <ToolDirectory currentId="image-to-pdf" mode="sidebar" />
    </aside>
  </div>
</Layout>
