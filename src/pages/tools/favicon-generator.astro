---
import Layout from '../../layouts/Layout.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import FaviconGenerator from '../../components/FaviconGenerator';

const faqItems = [
  {
    question: 'What is a favicon?',
    answer:
      'A favicon (favorite icon) is the small image shown in browser tabs, bookmarks, and mobile home screens. It helps users identify your website visually.',
  },
  {
    question: 'What sizes does this tool generate?',
    answer:
      'The tool generates five common PNG sizes: 16x16, 32x32, 180x180, 192x192, and 512x512, plus a site.webmanifest file. It does not generate an .ico file.',
  },
  {
    question: 'Is this favicon generator free?',
    answer:
      'Yes. There is no sign-up or watermark. Practical input size is limited by browser memory and Canvas dimensions.',
  },
  {
    question: 'What image should I use for my favicon?',
    answer:
      'Use a simple, square image — ideally 512x512 or larger. Logos, icons, or letters work best. Avoid complex photos as favicons are displayed very small.',
  },
  {
    question: 'How do I add the favicon to my website?',
    answer:
      "After downloading the ZIP, extract the files to your website's root directory and add the provided HTML code to your page's <head> section.",
  },
  {
    question: 'Does this work for WordPress?',
    answer:
      'Yes. For WordPress, upload the 512x512 image as your Site Icon in Appearance > Customize > Site Identity. The other files work with custom themes.',
  },
  {
    question: 'What is site.webmanifest?',
    answer:
      "It's a JSON file that tells browsers how to display your site when added to a mobile home screen. It's important for Progressive Web Apps (PWAs).",
  },
  {
    question: 'Are my images uploaded to a server?',
    answer:
      'No. Favicon generation uses the Canvas API and JSZip in your browser. The selected image contents are not sent to ToolkitFree for processing.',
  },
  {
    question: 'Can I use any image format?',
    answer:
      'JPG, PNG, and WebP are supported. Non-square images are centered with transparent padding. For best small-icon clarity, use a simple square PNG with transparency.',
  },
  {
    question: 'Does this tool generate favicon.ico?',
    answer:
      'No. The ZIP contains five PNG icons and site.webmanifest. The provided HTML references PNG favicon files.',
  },
  {
    question: 'What is the recommended favicon size?',
    answer:
      'The minimum recommended size is 512x512 pixels. Larger is fine. Square images produce the best results across all generated sizes.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Free Favicon Generator',
  description:
    'Generate 16x16, 32x32, 180x180, 192x192, and 512x512 PNG favicons plus a webmanifest in your browser.',
  url: 'https://toolkitfree.net/tools/favicon-generator',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toolkitfree.net' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Favicon Generator',
      item: 'https://toolkitfree.net/tools/favicon-generator',
    },
  ],
};
---

<Layout
  title="Free Favicon Generator — Create Five PNG Sizes"
  description="Generate five common PNG favicon sizes from one image, including Apple touch and Android Chrome icons. Download a ZIP with webmanifest and HTML code."
  structuredData={[
    structuredData,
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
    breadcrumbSchema,
  ]}
>
  <div class="tool-layout">
    <div class="tool-content">
      <h1>Free Online Favicon Generator</h1>
      <p style="color: var(--color-text-light); margin-bottom: 1.5rem;">
        Generate five common PNG favicon sizes from one image. Download a ZIP with a webmanifest and
        HTML code. All processing in your browser.
      </p>

      <div class="privacy-badge">
        <span style="color: #10b981; font-weight: 600;"
          >Selected file contents are processed in your browser</span
        >
      </div>

      <FaviconGenerator client:load />

      <section class="howto-section">
        <h2>How to Generate Favicons</h2>
        <ol class="howto-steps">
          <li>Upload a square image (PNG recommended, 512x512 or larger)</li>
          <li>Click "Generate Favicons"</li>
          <li>Preview all generated sizes</li>
          <li>Download the ZIP file</li>
          <li>Copy the HTML code and add it to your website</li>
        </ol>
      </section>

      <section class="features-section">
        <h2>Features</h2>
        <ul class="features-list">
          <li>Generates 16, 32, 180, 192, and 512px PNG icon sizes</li>
          <li>Includes site.webmanifest file</li>
          <li>Ready-to-use HTML code snippet</li>
          <li>Non-square images use transparent padding, never stretching</li>
          <li>PNG output only; no .ico file is generated</li>
          <li>Supports PNG, JPG, WebP, and more</li>
          <li>Selected image contents are processed locally in your browser</li>
        </ul>
      </section>

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {
          faqItems.map((item) => (
            <div class="faq-item">
              <details>
                <summary class="faq-question">{item.question}</summary>
                <div class="faq-answer">{item.answer}</div>
              </details>
            </div>
          ))
        }
      </section>

      <ToolDirectory currentId="favicon-generator" mode="related" />
    </div>
    <aside class="tool-sidebar">
      <ToolDirectory currentId="favicon-generator" mode="sidebar" />
    </aside>
  </div>
</Layout>
