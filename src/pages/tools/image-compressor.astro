---
import Layout from '../../layouts/Layout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import ProcessingLimits from '../../components/ProcessingLimits.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import ImageCompressor from '../../components/ImageCompressor';

const faqItems = [
  {
    question: 'How does image compression work?',
    answer:
      "Our compressor re-encodes your image using the browser's Canvas API. For JPEG images, it adjusts the compression level; for PNG, it uses PNG encoding. The selected image contents are not sent to ToolkitFree for compression.",
  },
  {
    question: "What's the difference between quality levels?",
    answer:
      'Visible quality and file-size reduction vary with the source image, dimensions, format, and selected quality. Compare the displayed result before downloading; lower quality settings can introduce visible artifacts.',
  },
  {
    question: 'Can I compress PNG images?',
    answer:
      'Yes, but PNG is a lossless format, so quality adjustment has no effect on PNG. You can reduce PNG file size by limiting the maximum width, which scales down the image dimensions.',
  },
  {
    question: 'How much can I reduce file size?',
    answer:
      'There is no guaranteed percentage. Results depend on image content, dimensions, original encoding, output format, and the selected quality setting.',
  },
  {
    question: 'Is there a batch compression limit?',
    answer:
      'There is no server-side batch quota, but the practical limit depends on available browser memory and image dimensions. Large batches can be slow or fail, especially on mobile devices.',
  },
  {
    question: 'Can I download all compressed images at once?',
    answer:
      'Yes. After processing, Download all as ZIP creates one local archive containing only successful results. Individual downloads remain available, and any failed file stays visible with its error reason.',
  },
  {
    question: 'Will compression affect image dimensions?',
    answer:
      'No, unless you set a Max Width limit. By default, compression only affects file quality, not dimensions. If you set a Max Width, images wider than that limit will be scaled down proportionally.',
  },
  {
    question: 'How do I make a photo smaller to email?',
    answer:
      "Choose your photo, try a lower quality or maximum width, and compare the displayed output size with your email provider's attachment limit. A specific output size is not guaranteed.",
  },
  {
    question: 'How do I reduce image file size to under 100KB?',
    answer:
      'Choose the "Exact size in KB" purpose and enter 100. The tool uses bounded quality and dimension search, then labels each result Target met only when its actual Blob is 100KB or less.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Free Image Compressor',
  description:
    'Compress JPG, PNG, and WebP images in your browser with adjustable quality and batch processing.',
  url: 'https://toolkitfree.net/tools/image-compressor',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toolkitfree.net' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Image Compressor',
      item: 'https://toolkitfree.net/tools/image-compressor',
    },
  ],
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title="Free Image Compressor - Reduce File Size Online"
  description="Compress JPG, PNG, and WebP images locally in your browser. Adjust quality or dimensions, process a batch, and compare the actual result."
  ogImage="/social/image-compressor.png"
  structuredData={[structuredData, faqStructuredData, breadcrumbSchema]}
>
  <div class="tool-layout">
    <div class="tool-content">
      <h1>Free Online Image Compressor</h1>
      <p style="color: var(--color-text-light); margin-bottom: 1.5rem;">
        Reduce image file size while maintaining quality. Adjustable compression level and batch
        support. Selected image contents are processed locally in your browser.
      </p>

      <ImageCompressor client:load />

      <section class="howto-section">
        <h2>How to Compress Images</h2>
        <ol class="howto-steps">
          <li>Choose one or more images (JPG, PNG, WebP)</li>
          <li>Pick what the file is for — the settings follow your choice</li>
          <li>
            Compare the three results and their real file sizes, or open Fine-tune to set quality
            and maximum width yourself
          </li>
          <li>Download files individually or once as a ZIP</li>
        </ol>
      </section>

      <section class="features-section">
        <h2>Features</h2>
        <ul class="features-list">
          <li>Purpose presets, with three finished results to compare</li>
          <li>Adjustable quality from 10% to 100% under Fine-tune</li>
          <li>Verified exact-size mode with an honest target status</li>
          <li>Optional starting max width</li>
          <li>Batch compress with one ZIP download</li>
          <li>Shows before/after file sizes</li>
          <li>Selected image contents are processed locally in your browser</li>
          <li>Capacity depends on browser memory and Canvas limits</li>
        </ul>
      </section>

      <RelatedGuides toolId="image-compressor" />

      <ProcessingLimits />

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {
          faqItems.map((item) => (
            <div class="faq-item">
              <details>
                <summary class="faq-question">{item.question}</summary>
                <div class="faq-answer">{item.answer}</div>
              </details>
            </div>
          ))
        }
      </section>

      <ToolDirectory currentId="image-compressor" mode="related" />
    </div>

    <aside class="tool-sidebar">
      <ToolDirectory currentId="image-compressor" mode="sidebar" />
    </aside>
  </div>
</Layout>
