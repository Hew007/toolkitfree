---
import Layout from '../../../layouts/Layout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import ImageCropper from '../../../components/ImageCropper';
import { allVariants, variantData } from '../../../data/cropper-variants';
import { CROP_ASPECT_PRESETS } from '../../../lib/image-cropper';

export function getStaticPaths() {
  return allVariants.map((v) => ({
    params: { variant: v.slug },
    props: {
      slug: v.slug,
      ...variantData[v.slug],
    },
  }));
}

const { title, description, defaultAspectPreset, faq, slug } = Astro.props;

const pageUrl = `https://toolkitfree.net/tools/image-cropper/${Astro.params.variant}`;

// The ratio this page opens on, read from the same table the aspect chips use.
const aspect = CROP_ASPECT_PRESETS[defaultAspectPreset as keyof typeof CROP_ASPECT_PRESETS];
const isFree = aspect.ratio === null;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description: description,
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toolkitfree.net' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Image Cropper',
      item: 'https://toolkitfree.net/tools/image-cropper',
    },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title={title}
  description={description}
  canonical={pageUrl}
  structuredData={[structuredData, faqStructuredData, breadcrumbSchema]}
>
  <div class="tool-layout">
    <div class="tool-content">
      <h1>{title}</h1>
      <p style="color: var(--color-text-light); margin-bottom: 1.5rem;">
        {description}
      </p>

      <div class="privacy-badge">
        <span style="color: #10b981; font-weight: 600;"
          >Selected file contents are processed in your browser</span
        >
      </div>

      <ImageCropper client:load defaultAspectPreset={defaultAspectPreset} />

      <section class="howto-section">
        <h2>
          {
            isFree
              ? 'How to Crop to Any Shape'
              : aspect.ratio === 1
                ? 'How to Crop an Image to a Square'
                : `How to Crop an Image to ${aspect.label}`
          }
        </h2>
        <ol class="howto-steps">
          <li>Upload your image</li>
          {
            isFree ? (
              <li>
                Free is already selected, so the crop box can take any shape — drag the box and its
                handles to choose the area you want to keep
              </li>
            ) : (
              <li>
                {aspect.label} is already selected, so the crop box keeps that shape — drag the box
                and its handles to choose the area you want to keep
              </li>
            )
          }
          <li>Pick another ratio under Crop shape if you need a different shape</li>
          <li>Open Fine-tune to change the output format or quality</li>
          <li>Download the cropped image, which follows the crop box</li>
        </ol>
      </section>

      <section class="features-section">
        <h2>Features</h2>
        <ul class="features-list">
          <li>Visual drag-and-drop crop area</li>
          <li>Rule-of-thirds grid overlay</li>
          <li>Output as PNG, JPG, or WebP</li>
          <li>Adjustable quality for JPG/WebP</li>
          <li>Selected image contents are processed locally in your browser</li>
        </ul>
      </section>

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {
          faq.map((item: { question: string; answer: string }) => (
            <div class="faq-item">
              <details>
                <summary class="faq-question">{item.question}</summary>
                <div class="faq-answer">{item.answer}</div>
              </details>
            </div>
          ))
        }
      </section>

      <section class="related-tools">
        <h2>More Crop Tools</h2>
        <div class="related-tools-grid">
          {
            allVariants
              .filter((v) => v.slug !== slug)
              .map((v) => (
                <a href={`/tools/image-cropper/${v.slug}/`} class="tool-card">
                  <h3>{v.label}</h3>
                </a>
              ))
          }
        </div>
      </section>
    </div>

    <aside class="tool-sidebar">
      <ToolDirectory currentId="image-cropper" mode="sidebar" />
    </aside>
  </div>
</Layout>
