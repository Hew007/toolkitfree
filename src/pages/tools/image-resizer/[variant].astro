---
import Layout from '../../../layouts/Layout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import ImageResizer from '../../../components/ImageResizer';
import { allVariants, variantData } from '../../../data/resizer-variants';
import {
  RESIZE_PRESETS,
  RESIZER_VARIANT_PRESETS,
  type ResizerVariantSlug,
} from '../../../lib/image-resizer';

export function getStaticPaths() {
  return allVariants.map((v) => ({
    params: { variant: v.slug },
    props: { slug: v.slug, ...variantData[v.slug] },
  }));
}

const { title, description, faq, slug } = Astro.props;
const presetKey = RESIZER_VARIANT_PRESETS[slug as ResizerVariantSlug];

// Platform presets draw into their exact width and height, so a source of another
// shape is stretched — the how-to says so, and names the way around it. Where the
// cropper has the same ratio, point there; otherwise only the Custom route is exact.
const preset = RESIZE_PRESETS[presetKey];
const presetShape = `${preset.width} × ${preset.height}`;
const cropperForShape: Record<string, { href: string; ratio: string } | undefined> = {
  '1080x1080': { href: '/tools/image-cropper/crop-to-square/', ratio: '1:1' },
  '1280x720': { href: '/tools/image-cropper/crop-to-16-9/', ratio: '16:9' },
  '1920x1080': { href: '/tools/image-cropper/crop-to-16-9/', ratio: '16:9' },
  '1080x1920': { href: '/tools/image-cropper/', ratio: '9:16' },
};
const matchingCrop = cropperForShape[`${preset.width}x${preset.height}`];

const pageUrl = `https://toolkitfree.net/tools/image-resizer/${Astro.params.variant}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description: description,
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toolkitfree.net' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Image Resizer',
      item: 'https://toolkitfree.net/tools/image-resizer',
    },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title={title}
  description={description}
  canonical={pageUrl}
  structuredData={[structuredData, faqStructuredData, breadcrumbSchema]}
>
  <div class="tool-layout">
    <div class="tool-content">
      <h1>{title}</h1>
      <p style="color: var(--color-text-light); margin-bottom: 1.5rem;">
        {description}
      </p>

      <ImageResizer client:load defaultPreset={presetKey} />

      <section class="howto-section">
        <h2>How to Resize to {presetShape}</h2>
        <ol class="howto-steps">
          <li>Upload one or more images</li>
          <li>
            {preset.label} is already selected, so every image comes out at exactly {presetShape}
            pixels
          </li>
          <li>
            An image with a different shape is stretched to fill that size.{' '}
            {
              matchingCrop ? (
                <>
                  To avoid that, crop it to {matchingCrop.ratio} first with the{' '}
                  <a href={matchingCrop.href}>Image Cropper</a>, or set Platform size to Custom —
                  Maintain aspect ratio switches on — and enter {preset.width} and {preset.height}
                  so the whole image fits inside that size instead
                </>
              ) : (
                <>
                  To avoid that, set Platform size to Custom — Maintain aspect ratio switches on —
                  and enter {preset.width} and {preset.height} so the whole image fits inside that
                  size instead
                </>
              )
            }
          </li>
          <li>Open Fine-tune to change the output format or quality</li>
          <li>Read the real output size, then download files individually or once as a ZIP</li>
        </ol>
      </section>

      <section class="features-section">
        <h2>Features</h2>
        <ul class="features-list">
          <li>Platform-specific size presets</li>
          <li>Custom width and height</li>
          <li>Maintain aspect ratio</li>
          <li>Batch resize support</li>
          <li>Multiple output formats</li>
          <li>Selected image contents are processed locally in your browser</li>
        </ul>
      </section>

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {
          faq.map((item: { question: string; answer: string }) => (
            <div class="faq-item">
              <details>
                <summary class="faq-question">{item.question}</summary>
                <div class="faq-answer">{item.answer}</div>
              </details>
            </div>
          ))
        }
      </section>

      <section class="related-tools">
        <h2>More Resize Tools</h2>
        <div class="related-tools-grid">
          {
            allVariants
              .filter((v) => v.slug !== slug)
              .map((v) => (
                <a href={`/tools/image-resizer/${v.slug}/`} class="tool-card">
                  <h3>{v.label}</h3>
                </a>
              ))
          }
        </div>
      </section>
    </div>

    <aside class="tool-sidebar">
      <ToolDirectory currentId="image-resizer" mode="sidebar" />
    </aside>
  </div>
</Layout>
