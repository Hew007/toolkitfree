---
import Layout from '../../layouts/Layout.astro';
import RelatedGuides from '../../components/RelatedGuides.astro';
import ProcessingLimits from '../../components/ProcessingLimits.astro';
import ToolDirectory from '../../components/ToolDirectory.astro';
import ImageResizer from '../../components/ImageResizer';

const faqItems = [
  {
    question: 'How do I resize an image?',
    answer:
      'Choose your image, select a preset size or enter custom dimensions, choose the output format, and click Resize. Download the result when browser processing finishes.',
  },
  {
    question: 'What presets are available?',
    answer:
      'We offer presets for Instagram Post, Instagram Story, Facebook Cover, Twitter/X Header, YouTube Thumbnail, Full HD, HD, and Thumbnail sizes.',
  },
  {
    question: 'What does "maintain aspect ratio" do?',
    answer:
      "When enabled, the tool automatically adjusts one dimension to match the original image's proportions. This prevents your image from appearing stretched or squished.",
  },
  {
    question: 'Can I resize multiple images at once?',
    answer:
      'Yes, you can upload and resize multiple images simultaneously. All images will be resized to the same dimensions.',
  },
  {
    question: 'Can I download all resized images at once?',
    answer:
      'Yes. Use Download all as ZIP for a single browser download containing every successful result. You can still download files one by one, while failed inputs remain listed separately.',
  },
  {
    question: 'What output formats are supported?',
    answer:
      'You can save resized images as JPG, PNG, or WebP. PNG supports transparency; JPG and WebP provide adjustable quality. Compare outputs for your use case.',
  },
  {
    question: 'How do I resize a photo for Instagram?',
    answer:
      'Upload your photo, select the Instagram Post preset (1080x1080), and click Resize. For Stories or Reels, choose the Instagram Story preset (1080x1920). Fixed presets use their exact dimensions; crop the image first if you do not want it stretched.',
  },
  {
    question: 'How do I crop an image to a specific size?',
    answer:
      'Enter your desired width and height, disable "Maintain aspect ratio" if you want exact dimensions, and click Resize. The image will be scaled to fit your specified dimensions.',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Free Image Resizer',
  description:
    'Resize images in your browser with presets for Instagram, Facebook, Twitter, and YouTube. Crop, scale, and batch resize.',
  url: 'https://toolkitfree.net/tools/image-resizer',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toolkitfree.net' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Image Resizer',
      item: 'https://toolkitfree.net/tools/image-resizer',
    },
  ],
};
---

<Layout
  title="Free Image Resizer - Resize Images to Any Size"
  description="Resize and crop images in your browser with presets for Instagram, Facebook, Twitter, and YouTube. Change dimensions, preserve aspect ratio, or batch resize."
  structuredData={[
    structuredData,
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
    breadcrumbSchema,
  ]}
>
  <div class="tool-layout">
    <div class="tool-content">
      <h1>Free Online Image Resizer</h1>
      <p style="color: var(--color-text-light); margin-bottom: 1.5rem;">
        Resize images to any dimension. Presets for social media. Aspect ratio lock. Batch support.
        All processing in your browser.
      </p>

      <ImageResizer client:load />

      <section class="howto-section">
        <h2>How to Resize Images</h2>
        <ol class="howto-steps">
          <li>Upload one or more images</li>
          <li>Choose a preset or enter custom width and height</li>
          <li>Select output format and quality</li>
          <li>Click "Resize", then download files individually or once as a ZIP</li>
        </ol>
      </section>

      <section class="features-section">
        <h2>Features</h2>
        <ul class="features-list">
          <li>Presets for Instagram, Facebook, Twitter, YouTube</li>
          <li>Custom width and height</li>
          <li>Maintain aspect ratio option</li>
          <li>Output as JPG, PNG, or WebP</li>
          <li>Batch resize with one ZIP download</li>
          <li>Selected image contents are processed locally in your browser</li>
        </ul>
      </section>

      <RelatedGuides toolId="image-resizer" />

      <ProcessingLimits />

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {
          faqItems.map((item) => (
            <div class="faq-item">
              <details>
                <summary class="faq-question">{item.question}</summary>
                <div class="faq-answer">{item.answer}</div>
              </details>
            </div>
          ))
        }
      </section>

      <ToolDirectory currentId="image-resizer" mode="related" />
    </div>
    <aside class="tool-sidebar">
      <ToolDirectory currentId="image-resizer" mode="sidebar" />
    </aside>
  </div>
</Layout>
