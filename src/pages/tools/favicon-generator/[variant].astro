---
import Layout from '../../../layouts/Layout.astro';
import ToolDirectory from '../../../components/ToolDirectory.astro';
import FaviconGenerator from '../../../components/FaviconGenerator';
import { allVariants, variantData } from '../../../data/favicon-variants';

export function getStaticPaths() {
  return allVariants.map((v) => ({
    params: { variant: v.slug },
    props: { slug: v.slug, ...variantData[v.slug] },
  }));
}

const { title, description, faq, slug } = Astro.props;

// The URL is the page's promise, so the chip that answers the same question
// starts on the answer this route already gave. WordPress builds every smaller
// size from the site icon itself, which is why that page opens on 512 alone.
const defaultSizeSet = slug === 'favicon-for-wordpress' ? 'largest' : 'all';
const isWordPress = slug === 'favicon-for-wordpress';
const sourceNoun =
  slug === 'jpg-to-favicon'
    ? 'JPG image'
    : slug === 'png-to-favicon'
      ? 'PNG image'
      : slug === 'logo-to-favicon'
        ? 'logo'
        : 'logo or image';
const sourceStep =
  `Upload your ${sourceNoun} — a square image of 512x512 or larger gives the sharpest icons` +
  (slug === 'jpg-to-favicon'
    ? '. A JPG has no transparency, so its background stays in the icons'
    : '');

const pageUrl = `https://toolkitfree.net/tools/favicon-generator/${Astro.params.variant}`;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: title,
  description: description,
  url: pageUrl,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://toolkitfree.net' },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Favicon Generator',
      item: 'https://toolkitfree.net/tools/favicon-generator',
    },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const faqStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item: { question: string; answer: string }) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title={title}
  description={description}
  canonical={pageUrl}
  structuredData={[structuredData, faqStructuredData, breadcrumbSchema]}
>
  <div class="tool-layout">
    <div class="tool-content">
      <h1>{title}</h1>
      <p style="color: var(--color-text-light); margin-bottom: 1.5rem;">
        {description}
      </p>

      <div class="privacy-badge">
        <span style="color: #10b981; font-weight: 600;"
          >Selected file contents are processed in your browser</span
        >
      </div>

      <FaviconGenerator client:load defaultSizeSet={defaultSizeSet} />

      <section class="howto-section">
        <h2>
          {
            isWordPress
              ? 'How to Add a Favicon to WordPress'
              : `How to Turn a ${sourceNoun === 'logo' ? 'Logo' : sourceNoun.replace(' image', '')} Into a Favicon`
          }
        </h2>
        <ol class="howto-steps">
          <li>{sourceStep}</li>
          {
            isWordPress ? (
              <>
                <li>
                  Largest icon only is already selected: WordPress builds every smaller size from
                  one 512x512 site icon
                </li>
                <li>Download the ZIP and take android-chrome-512x512.png out of it</li>
                <li>
                  In WordPress, open Appearance &gt; Customize &gt; Site Identity &gt; Site Icon and
                  upload that file
                </li>
              </>
            ) : (
              <>
                <li>
                  Website and app icons is already selected: all five sizes from 16 to 512 px, plus
                  a site.webmanifest
                </li>
                <li>Open Fine-tune to add or remove individual sizes</li>
                <li>Download the ZIP and copy the HTML snippet into your site's &lt;head&gt;</li>
              </>
            )
          }
        </ol>
      </section>

      <section class="features-section">
        <h2>Features</h2>
        <ul class="features-list">
          <li>Choose from 16, 32, 180, 192, and 512px PNG icon sizes</li>
          <li>Icons redraw as you change the size set; no separate generate step</li>
          <li>site.webmanifest generated when a 192 or 512px icon is selected</li>
          <li>HTML code snippet listing exactly the sizes you generated</li>
          <li>High-quality image scaling</li>
          <li>Selected image contents are processed locally in your browser</li>
        </ul>
      </section>

      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        {
          faq.map((item: { question: string; answer: string }) => (
            <div class="faq-item">
              <details>
                <summary class="faq-question">{item.question}</summary>
                <div class="faq-answer">{item.answer}</div>
              </details>
            </div>
          ))
        }
      </section>

      <section class="related-tools">
        <h2>More Favicon Tools</h2>
        <div class="related-tools-grid">
          {
            allVariants
              .filter((v) => v.slug !== slug)
              .map((v) => (
                <a href={`/tools/favicon-generator/${v.slug}/`} class="tool-card">
                  <h3>{v.label}</h3>
                </a>
              ))
          }
        </div>
      </section>
    </div>

    <aside class="tool-sidebar">
      <ToolDirectory currentId="favicon-generator" mode="sidebar" />
    </aside>
  </div>
</Layout>
