/generated/background-removal/1.7.0/*
  Cache-Control: public, max-age=31556952, immutable

# Background Remover runs ONNX Runtime's WASM build, which asks for one thread
# per CPU core. Threads need SharedArrayBuffer, which the browser only grants to
# a cross-origin isolated document — so without these two headers the model runs
# single-threaded no matter how many cores the visitor has. Scoped to this one
# route: the page has no cross-origin subresources (the model and runtime are
# self-hosted), and isolating the whole site would risk third-party embeds.
#
# Exactly ONE rule may match this page. An earlier version also listed
# `/tools/background-remover/` on its own; both rules matched, each policy was
# sent twice, and a browser joins repeated values into `same-origin, same-origin`
# — not a valid value, so it falls back to unsafe-none and the page is not
# isolated at all. The wildcard already covers the trailing-slash URL.
/tools/background-remover/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
