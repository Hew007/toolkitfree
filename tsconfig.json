{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  // Keep generated assets and local QA evidence (including browser extensions
  // inside dedicated test profiles) out of the base config's allowJs glob.
  "exclude": ["dist", "public", "docs", "test-fixtures", ".local-backups", ".tmp-*"]
}
